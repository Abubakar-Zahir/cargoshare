# Copy to .env (cargoshare-dev) and .env.test (cargoshare-test). Never commit the copies.
# Every key below is required unless it has a default noted next to it.

# development | test | production
APP_ENV=development

# Supabase dashboard > Connect > Transaction pooler (port 6543). Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<pooler-host>:6543/postgres

# JSON list of browser origins allowed to call the API. Never "*".
CORS_ORIGINS=["http://localhost:3000"]

# DEBUG | INFO | WARNING | ERROR (default INFO)
LOG_LEVEL=INFO
