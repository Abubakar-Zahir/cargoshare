{
  "name": "cargoshare-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next typegen && eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:api": "openapi-typescript ../docs/openapi.json -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "date-fns": "4.4.0",
    "get-nonce": "1.0.1",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "next": "16.4.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.4",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "4.3.3",
