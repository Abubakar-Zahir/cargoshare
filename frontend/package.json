{
  "name": "cargoshare-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next typegen && eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src next.config.ts eslint.config.mjs tsconfig.json package.json pnpm-workspace.yaml",
    "format:check": "prettier --check src next.config.ts eslint.config.mjs tsconfig.json package.json pnpm-workspace.yaml"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "prettier": {
    "printWidth": 100
  }
}
