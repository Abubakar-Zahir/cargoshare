# Copy to .env.local and fill in. Never commit .env.local.
# Only PUBLIC values belong here. A secret or service role key makes the build fail.

# Supabase dashboard > Project Settings > API (dev project)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase dashboard > Project Settings > API Keys > Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>

# The FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Where this site runs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
